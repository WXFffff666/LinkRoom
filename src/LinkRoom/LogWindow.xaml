<Window x:Class="LinkRoom.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:res="clr-namespace:LinkRoom.Core.Resources;assembly=LinkRoom.Core"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{x:Static res:Strings.LogTitle}" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{x:Static res:Strings.LogHeader}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" DockPanel.Dock="Left"/>
            <Button Content="{x:Static res:Strings.LogClear}" FontSize="11" Click="Clear_Click" DockPanel.Dock="Right"
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource DangerRed}" Cursor="Hand"/>
            <Button Content="{x:Static res:Strings.LogCopy}" FontSize="11" Click="Copy_Click" DockPanel.Dock="Right" Margin="0,0,8,0"
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandBlue}" Cursor="Hand"/>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource LogBackground}" BorderBrush="{DynamicResource NeutralBorder}"
                BorderThickness="1" CornerRadius="8">
            <TextBox x:Name="LogContent" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="11" Background="{DynamicResource LogBackground}" Foreground="{DynamicResource TextOnDark}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" BorderThickness="0"/>
        </Border>

        <Button Grid.Row="2" Content="{x:Static res:Strings.LogClose}" Height="32" FontSize="12" Margin="0,8,0,0"
                Click="Close_Click"/>
    </Grid>
</Window>
