<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================
         LinkRoom color palette — single source of truth for ALL color
         literals.  Theme-dependent roles ship Light/Dark variants that
         are selected by the theme dictionaries in App.xaml; the
         semantic brush keys (TextPrimary / NeutralCard / ...) resolve
         to one of these depending on the active theme.
         ============================================================ -->

    <!-- Brand / accent (theme-independent) -->
    <SolidColorBrush x:Key="BrandBlue" Color="#007AFF"/>
    <SolidColorBrush x:Key="BrandBlueHover" Color="#0056CC"/>
    <SolidColorBrush x:Key="DangerRed" Color="#FF3B30"/>
    <SolidColorBrush x:Key="SuccessGreen" Color="#34C759"/>
    <SolidColorBrush x:Key="WarningOrange" Color="#FF9500"/>

    <!-- Status indicators (theme-independent) -->
    <SolidColorBrush x:Key="StatusConnecting" Color="#FF9500"/>
    <SolidColorBrush x:Key="StatusConnected" Color="#34C759"/>
    <SolidColorBrush x:Key="StatusError" Color="#FF3B30"/>

    <!-- Always-dark log console (theme-independent) -->
    <SolidColorBrush x:Key="LogBackground" Color="#1E1E1E"/>
    <!-- Light text intended for always-dark surfaces, usable in both themes -->
    <SolidColorBrush x:Key="TextOnDark" Color="#D4D4D4"/>

    <!-- Light theme variants -->
    <SolidColorBrush x:Key="TextPrimaryLight" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="TextSecondaryLight" Color="#6E6E73"/>
    <SolidColorBrush x:Key="TextTertiaryLight" Color="#8E8E93"/>
    <SolidColorBrush x:Key="TextFaintLight" Color="#C7C7CC"/>
    <SolidColorBrush x:Key="SurfaceBackgroundLight" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="CardBackgroundLight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NeutralCardLight" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="NeutralBorderLight" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="StatusIdleLight" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="SuccessTintLight" Color="#E8F5E9"/>
    <SolidColorBrush x:Key="SuccessTextStrongLight" Color="#2E7D32"/>
    <SolidColorBrush x:Key="SuccessTextDeepLight" Color="#1B5E20"/>
    <SolidColorBrush x:Key="SuccessTextMediumLight" Color="#388E3C"/>
    <SolidColorBrush x:Key="InfoTintLight" Color="#F0F4FF"/>

    <!-- Dark theme variants -->
    <SolidColorBrush x:Key="TextPrimaryDark" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="TextSecondaryDark" Color="#AEAEB2"/>
    <SolidColorBrush x:Key="TextTertiaryDark" Color="#98989D"/>
    <SolidColorBrush x:Key="TextFaintDark" Color="#636366"/>
    <SolidColorBrush x:Key="SurfaceBackgroundDark" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="CardBackgroundDark" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="NeutralCardDark" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="NeutralBorderDark" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="StatusIdleDark" Color="#98989D"/>
    <SolidColorBrush x:Key="SuccessTintDark" Color="#1E3A2B"/>
    <SolidColorBrush x:Key="SuccessTextStrongDark" Color="#A5D6A7"/>
    <SolidColorBrush x:Key="SuccessTextDeepDark" Color="#81C784"/>
    <SolidColorBrush x:Key="SuccessTextMediumDark" Color="#A5D6A7"/>
    <SolidColorBrush x:Key="InfoTintDark" Color="#1D2B3A"/>
</ResourceDictionary>
